{
  "name": "servicenow-logs-ot-demo",
  "description": "SAMPLE ServiceNow incident events (NDJSON, real integration field names) tailed from /var/log/ot-demo/servicenow.ndjson. The real integration is not configured.",
  "namespace": "default",
  "policy_ids": [
    "__POLICY_ID__"
  ],
  "package": {
    "name": "filestream",
    "version": "__PACKAGE_VERSION__"
  },
  "inputs": {
    "filestream-filestream": {
      "enabled": true,
      "streams": {
        "filestream.filestream": {
          "enabled": true,
          "vars": {
            "paths": [
              "/var/log/ot-demo/servicenow.ndjson"
            ],
            "data_stream.dataset": "servicenow.event",
            "use_logs_stream": false,
            "parsers": "- ndjson:\n    target: \"\"\n    overwrite_keys: true\n    add_error_key: true\n",
            "tags": [
              "ot-demo",
              "servicenow",
              "sample-data"
            ]
          }
        }
      }
    }
  }
}
