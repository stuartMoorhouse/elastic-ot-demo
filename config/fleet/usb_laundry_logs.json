{
  "name": "usb-laundry-logs-ot-demo",
  "description": "Synthetic USB laundry (media sanitisation kiosk) events (NDJSON) tailed from /var/log/ot-demo/usb_laundry.ndjson",
  "namespace": "default",
  "policy_ids": [
    "__POLICY_ID__"
  ],
  "package": {
    "name": "filestream",
    "version": "__PACKAGE_VERSION__"
  },
  "inputs": {
    "filestream-filestream": {
      "enabled": true,
      "streams": {
        "filestream.filestream": {
          "enabled": true,
          "vars": {
            "paths": [
              "/var/log/ot-demo/usb_laundry.ndjson"
            ],
            "data_stream.dataset": "usb_laundry.events",
            "use_logs_stream": false,
            "parsers": "- ndjson:\n    target: \"\"\n    overwrite_keys: true\n    add_error_key: true\n",
            "tags": [
              "ot-demo",
              "usb-laundry"
            ]
          }
        }
      }
    }
  }
}
